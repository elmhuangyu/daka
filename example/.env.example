# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Required: encrypts external calendar URLs. Generate with: openssl rand -hex 32
DAKA_SECRET_KEY=

# Login (the container listens on a non-loopback address). Choose one.
# Option A: shared secret, 16+ characters, behind a TLS reverse proxy only.
DAKA_AUTH_ALLOW_INSECURE_PUBLIC=1
DAKA_AUTH_SHARED_SECRET=
# Option B: OIDC (remove option A).
# DAKA_AUTH_ISSUER=https://id.example.com
# DAKA_AUTH_CLIENT_ID=daka
# DAKA_AUTH_CLIENT_SECRET=
# DAKA_AUTH_REDIRECT_URL=https://daka.example.com/api/auth/oidc/callback

# Host names accepted behind a reverse proxy (DNS-rebinding guard).
# DAKA_ALLOWED_HOSTS=daka.example.com
# DAKA_TRUSTED_PROXIES=172.16.0.0/12

# Optional: key rotation (comma-separated retired keys).
# DAKA_SECRET_KEY_OLD=

# Plain-HTTP testing only. Leave unset in production.
# DAKA_AUTH_SECURE_COOKIE=0
